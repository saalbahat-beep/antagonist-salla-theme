{#
  Antagonist pre-drop landing page
#}

{% extends "layouts.master" %}

{% block content %}

<main class="antagonist-landing">

  <div class="antagonist-landing__noise"></div>

  <section class="antagonist-landing__hero">
    <div class="antagonist-landing__content">

      <h1 class="antagonist-landing__brand-main">
        ANTAGONIST
      </h1>

      <p class="antagonist-landing__drop">
        DROP 001 — COMING SOON
      </p>

      <h2 class="antagonist-landing__title">
        NOT FOR EVERYONE.
      </h2>

      <form class="antagonist-landing__form" action="#" method="post">
        <input
          class="antagonist-landing__input"
          type="email"
          name="email"
          placeholder="email"
          required
        >

        <button class="antagonist-landing__button" type="submit">
          NOTIFY ME
        </button>
      </form>

      <p class="antagonist-landing__note">
        Join the first colony.
      </p>

    </div>
  </section>

</main>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}